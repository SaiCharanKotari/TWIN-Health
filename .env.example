# TwinHealth AI — Environment Variables Template
# ─────────────────────────────────────────────
# 1. Copy this file:  copy .env.example .env
# 2. Fill in values
# 3. NEVER commit .env to Git

# ── Provider selection ─────────────────────────────────────────
# Options: mock | gemini | huggingface
# "mock"   → No API key needed, realistic demo results (dev/testing)
# "gemini" → Uses Google Gemini AI (requires GEMINI_API_KEY below)
# "huggingface" → Uses HF Inference API (requires HF_API_KEY + model IDs)
DEFAULT_PROVIDER=gemini

# ── Google Gemini API ──────────────────────────────────────────
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── HuggingFace Inference API ──────────────────────────────────
# Get your key at: https://huggingface.co/settings/tokens
HF_API_KEY=

# HuggingFace model IDs per disease (fill in when you have model IDs)
# Example: HF_DIABETES_MODEL=your-username/diabetes-classifier
HF_DIABETES_MODEL=
HF_HEART_MODEL=
HF_CKD_MODEL=
HF_LIVER_MODEL=
HF_STROKE_MODEL=

# ── Request settings ───────────────────────────────────────────
API_TIMEOUT_SECONDS=30
API_RETRY_ATTEMPTS=2
